# Copy to .env and fill in, or export these in your shell.
# --- Pick ONE provider block ---

# OpenAI
SWARM_BASE_URL=https://api.openai.com/v1
SWARM_API_KEY=sk-...
SWARM_MODEL=gpt-4o-mini

# Groq (fast + cheap)
# SWARM_BASE_URL=https://api.groq.com/openai/v1
# SWARM_API_KEY=gsk_...
# SWARM_MODEL=llama-3.3-70b-versatile

# Anthropic (OpenAI-compat endpoint)
# SWARM_BASE_URL=https://api.anthropic.com/v1/
# SWARM_API_KEY=sk-ant-...
# SWARM_MODEL=claude-sonnet-5

# LM Studio on your M5 Pro (the endgame — fully local, free)
# SWARM_BASE_URL=http://localhost:1234/v1
# SWARM_API_KEY=lm-studio
# SWARM_MODEL=qwen3-32b

# Ollama on your M5 Pro
# SWARM_BASE_URL=http://localhost:11434/v1
# SWARM_API_KEY=ollama
# SWARM_MODEL=qwen3:32b

# Test mode (no network, deterministic mock brain)
# SWARM_MOCK=1
